; BEGIN string_begins_with
define zeroext i1 @{0}(i8* %data, i64 %size) nounwind readonly {{
entry:
  %matched = call i1 @{1}(i8* %data, i64 %size, i64 0)
  ret i1 %matched
}}
; END string_begins_with

; BEGIN string_ends_with
define zeroext i1 @{0}(i8* %data, i64 %size) nounwind readonly {{
entry:
  %enough = icmp uge i64 %size, {1}
  %position = sub i64 %size, {1}
  br i1 %enough, label %compare, label %no
compare:
  %matched = call i1 @{2}(i8* %data, i64 %size, i64 %position)
  ret i1 %matched
no:
  ret i1 false
}}
; END string_ends_with

; BEGIN string_ends_line
define zeroext i1 @{0}(i8* %data, i64 %size) nounwind readonly {{
entry:
  %enough = icmp uge i64 %size, {1}
  br i1 %enough, label %at_end, label %no
at_end:
  %end_position = sub i64 %size, {1}
  %end_match = call i1 @{2}(i8* %data, i64 %size, i64 %end_position)
  br i1 %end_match, label %yes, label %before_newline_check
before_newline_check:
  %has_extra = icmp ugt i64 %size, {1}
  br i1 %has_extra, label %load_last, label %no
load_last:
  %last_position = sub i64 %size, 1
  %last_ptr = getelementptr i8, i8* %data, i64 %last_position
  %last = call i32 @{3}(i8* %last_ptr)
  %is_lf = icmp eq i32 %last, 10
  %line_position = sub i64 %last_position, {1}
  br i1 %is_lf, label %before_newline, label %no
before_newline:
  %line_match = call i1 @{2}(i8* %data, i64 %size, i64 %line_position)
  ret i1 %line_match
yes:
  ret i1 true
no:
  ret i1 false
}}
; END string_ends_line

; BEGIN string_equals
define zeroext i1 @{0}(i8* %data, i64 %size) nounwind readonly {{
entry:
  %same_size = icmp eq i64 %size, {1}
  br i1 %same_size, label %compare, label %no
compare:
  %matched = call i1 @{2}(i8* %data, i64 %size, i64 0)
  ret i1 %matched
no:
  ret i1 false
}}
; END string_equals

; BEGIN string_equals_line
define zeroext i1 @{0}(i8* %data, i64 %size) nounwind readonly {{
entry:
  %exact_size = icmp eq i64 %size, {1}
  %line_size = icmp eq i64 %size, {2}
  br i1 %exact_size, label %compare, label %line_check
line_check:
  br i1 %line_size, label %load_last, label %no
load_last:
  %last_ptr = getelementptr i8, i8* %data, i64 {1}
  %last = call i32 @{3}(i8* %last_ptr)
  %is_lf = icmp eq i32 %last, 10
  br i1 %is_lf, label %compare, label %no
compare:
  %matched = call i1 @{4}(i8* %data, i64 %size, i64 0)
  ret i1 %matched
no:
  ret i1 false
}}
; END string_equals_line

; BEGIN fixed_ascii_class_at
define internal zeroext i1 @{0}(i8* %data, i64 %size, i64 %position) nounwind readonly {{
entry:
{1}  ret i1 {2}
}}
; END fixed_ascii_class_at

