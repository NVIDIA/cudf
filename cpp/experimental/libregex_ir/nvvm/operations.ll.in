entry:
  %match_begin = alloca i64, align 8
  %match_end = alloca i64, align 8
  %matched = call i1 @{1}(i8* %data, i64 %size, i64 0, i64* %match_begin, i64* %match_end, i64* null)
  %count = zext i1 %matched to i64
  ret i64 %count
}}
