; END find_capture_ptr_n

; BEGIN store_store_i64_start_i64_position_align_8
  store i64 %start, i64* %position, align 8
  %matched = call i1 @{0}(@workspace@i32 {1}, i8* %data, i64 %size, i64* %position, i64* {2})
