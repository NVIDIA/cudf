; Records hold a state ID and only the observable capture slots.
; BEGIN candidate_functions
define internal i1 @{0}(i32 %byte) alwaysinline nounwind readnone {{
entry:
  %word = lshr i32 %byte, 6
  %zero = icmp eq i32 %word, 0
  %one = icmp eq i32 %word, 1
  %two = icmp eq i32 %word, 2
  %upper = select i1 %two, i64 {3}, i64 {4}
  %middle = select i1 %one, i64 {2}, i64 %upper
  %bitmap = select i1 %zero, i64 {1}, i64 %middle
  %bit32 = and i32 %byte, 63
  %bit = zext i32 %bit32 to i64
  %mask = shl i64 1, %bit
  %present = and i64 %bitmap, %mask
  %result = icmp ne i64 %present, 0
  ret i1 %result
}}
define internal i64 @{5}(i8* %data, i64 %size, i64 %start) alwaysinline nounwind readonly {{
entry:
  br label %scan
scan:
  %pos = phi i64 [ %start, %entry ], [ %next, %advance ]
  %available = icmp ult i64 %pos, %size
  br i1 %available, label %test, label %done
test:
  %ptr = getelementptr i8, i8* %data, i64 %pos
  %byte8 = load i8, i8* %ptr, align 1
  %byte = zext i8 %byte8 to i32
  %candidate = call i1 @{0}(i32 %byte)
  br i1 %candidate, label %done, label %advance
advance:
  %next = add i64 %pos, 1
  br label %scan
done:
  ret i64 %pos
}}
; END candidate_functions
; BEGIN copy
define internal void @{0}(i64* %dst, i64* %src) alwaysinline nounwind {{
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %next, %loop ]
  %s = getelementptr i64, i64* %src, i64 %i
  %d = getelementptr i64, i64* %dst, i64 %i
  %v = load i64, i64* %s, align 8
  store i64 %v, i64* %d, align 8
  %next = add i64 %i, 1
  %more = icmp ult i64 %next, {1}
  br i1 %more, label %loop, label %done
done:
  ret void
}}
; END copy

; BEGIN run
define internal i1 @{0}(@workspace@i32 %block, i8* %data, i64 %size, i64* %position, i64* %captures) {1} nounwind {{
entry:
{2}
  %base = bitcast i8* %storage to i64*
  %other = getelementptr i64, i64* %base, i64 {3}
  %stack = getelementptr i64, i64* %base, i64 {4}
  %active = getelementptr i64, i64* %base, i64 {5}
  %seen = getelementptr i64, i64* %base, i64 {6}
  %queued = getelementptr i64, i64* %base, i64 {7}
  %sp = alloca i64, align 8
  %next_count = alloca i64, align 8
  %root = zext i32 %block to i64
  store i64 %root, i64* %base, align 8
{8}
  %initial_position = load i64, i64* %position, align 8
  br label %iteration
iteration:
  %current = phi i64* [ %base, %entry ], [ %next_list, %advance ]
  %next_list = phi i64* [ %other, %entry ], [ %current, %advance ]
  %count = phi i64 [ 1, %entry ], [ %produced, %advance ]
  %iteration_pos = phi i64 [ %initial_position, %entry ], [ %advanced, %advance ]
  %found = phi i1 [ false, %entry ], [ %accepted, %advance ]
  %front_state = load i64, i64* %current, align 8
  %pos = call i64 @{16}(i8* %data, i64 %size, i64 %iteration_pos, {18}, i64 %count)
  %cp = call i32 @{17}(i8* %data, i64 %size, i64 %pos)
  store i64 0, i64* %next_count, align 8
  br label %clear
clear:
  %clear_i = phi i64 [ 0, %iteration ], [ %clear_next, %clear ]
  %seen_ptr = getelementptr i64, i64* %seen, i64 %clear_i
  %queued_ptr = getelementptr i64, i64* %queued, i64 %clear_i
  store i64 0, i64* %seen_ptr, align 8
  store i64 0, i64* %queued_ptr, align 8
  %clear_next = add i64 %clear_i, 1
  %clear_more = icmp ult i64 %clear_next, {9}
  br i1 %clear_more, label %clear, label %seed
seed:
  %seed_i = phi i64 [ 0, %clear ], [ %seed_next, %next_seed ]
  %seed_offset = mul i64 %seed_i, {10}
  %seed_ptr = getelementptr i64, i64* %current, i64 %seed_offset
  call void @{11}(i64* %active, i64* %seed_ptr)
  store i64 0, i64* %sp, align 8
  br label %active_state
pop:
  %depth = load i64, i64* %sp, align 8
  %empty = icmp eq i64 %depth, 0
  br i1 %empty, label %next_seed, label %take
take:
  %top = sub i64 %depth, 1
  store i64 %top, i64* %sp, align 8
  %top_offset = mul i64 %top, {10}
  %top_ptr = getelementptr i64, i64* %stack, i64 %top_offset
  call void @{11}(i64* %active, i64* %top_ptr)
  br label %active_state
active_state:
  %state = load i64, i64* %active, align 8
  %state_word = lshr i64 %state, 6
  %state_bit = and i64 %state, 63
  %state_mask = shl i64 1, %state_bit
  %visited_ptr = getelementptr i64, i64* %seen, i64 %state_word
  %visited = load i64, i64* %visited_ptr, align 8
  %visited_bit = and i64 %visited, %state_mask
  %duplicate = icmp ne i64 %visited_bit, 0
  br i1 %duplicate, label %pop, label %dispatch
dispatch:
  %visited_next = or i64 %visited, %state_mask
  store i64 %visited_next, i64* %visited_ptr, align 8
  switch i64 %state, label %pop [
{12}  ]
{13}
accept:
  store i64 %pos, i64* %position, align 8
{14}
  br label %finish_position
next_seed:
  %seed_next = add i64 %seed_i, 1
  %seeds_left = icmp ult i64 %seed_next, %count
  br i1 %seeds_left, label %seed, label %finish_position
finish_position:
  %accepted = phi i1 [ true, %accept ], [ %found, %next_seed ]
  %produced = load i64, i64* %next_count, align 8
  %live = icmp ne i64 %produced, 0
  br i1 %live, label %advance, label %done
advance:
  %advanced = call i64 @{15}(i8* %data, i64 %size, i64 %pos, i64 1)
  br label %iteration
done:
  ret i1 %accepted
}}
; END run

; BEGIN single_run_scanner
define internal i64 @{0}(i8* %data, i64 %size, i64 %pos, i64 %state, i64 %count) alwaysinline nounwind readonly {{
entry:
  %single = icmp eq i64 %count, 1
  br i1 %single, label %dispatch, label %unchanged
dispatch:
  switch i64 %state, label %unchanged [
{1}  ]
{2}
unchanged:
  ret i64 %pos
}}
; END single_run_scanner

; BEGIN run_scanner
define internal i64 @{0}(i8* %data, i64 %size, i64 %pos, i64* %current, i64 %count) alwaysinline nounwind readonly {{
entry:
  %single = icmp eq i64 %count, 1
  br i1 %single, label %single_dispatch, label %multi_entry
single_dispatch:
  %single_state = load i64, i64* %current, align 8
  switch i64 %single_state, label %unchanged [
{4}  ]
{5}
multi_entry:
  %bounded = icmp ule i64 %count, 8
  br i1 %bounded, label %check_state, label %unchanged
check_state:
  %index = phi i64 [ 0, %multi_entry ], [ %next_index, %next_state ]
  %low = phi i64 [ -1, %multi_entry ], [ %low_next, %next_state ]
  %high = phi i64 [ -1, %multi_entry ], [ %high_next, %next_state ]
  %offset = mul i64 %index, {3}
  %record = getelementptr i64, i64* %current, i64 %offset
  %state = load i64, i64* %record, align 8
  br label %dispatch
dispatch:
  switch i64 %state, label %unchanged [
{1}  ]
{2}
next_state:
  %low_next = phi i64 {6}
  %high_next = phi i64 {7}
  %next_index = add i64 %index, 1
  %more = icmp ult i64 %next_index, %count
  br i1 %more, label %check_state, label %scan
scan:
  %cursor = phi i64 [ %pos, %next_state ], [ %next_cursor, %step ]
  %in_bounds = icmp ult i64 %cursor, %size
  br i1 %in_bounds, label %byte, label %done
byte:
  %ptr = getelementptr i8, i8* %data, i64 %cursor
  %value = load i8, i8* %ptr, align 1
  %ascii = icmp ult i8 %value, 128
  %lower = icmp ult i8 %value, 64
  %bits = select i1 %lower, i64 %low_next, i64 %high_next
  %cp = zext i8 %value to i64
  %bit = and i64 %cp, 63
  %shifted = lshr i64 %bits, %bit
  %matches = trunc i64 %shifted to i1
  %advance_byte = and i1 %ascii, %matches
  br i1 %advance_byte, label %step, label %done
step:
  %next_cursor = add i64 %cursor, 1
  br label %scan
done:
  ret i64 %cursor
unchanged:
  ret i64 %pos
}}
; END run_scanner

; BEGIN run_scanner_empty
define internal i64 @{0}(i8* %data, i64 %size, i64 %pos, i64* %current, i64 %count) alwaysinline nounwind readnone {{
entry:
  ret i64 %pos
}}
; END run_scanner_empty

; BEGIN multi_scan_case
multi_run_{0}:
  %low_{0} = and i64 %low, {1}
  %high_{0} = and i64 %high, {2}
  br label %next_state
; END multi_scan_case

; BEGIN scan_case
run_{0}:
  br label %scan_{0}
scan_{0}:
  %cursor_{0} = phi i64 [ %pos, %run_{0} ], [ %next_{0}, %step_{0} ]
  %in_bounds_{0} = icmp ult i64 %cursor_{0}, %size
  br i1 %in_bounds_{0}, label %byte_{0}, label %done_{0}
byte_{0}:
  %ptr_{0} = getelementptr i8, i8* %data, i64 %cursor_{0}
  %value_{0} = load i8, i8* %ptr_{0}, align 1
  %ascii_{0} = icmp ult i8 %value_{0}, 128
  br i1 %ascii_{0}, label %test_{0}, label %done_{0}
test_{0}:
  %cp_{0} = zext i8 %value_{0} to i32
  %matches_{0} = call i1 @{1}(i32 %cp_{0})
  br i1 %matches_{0}, label %step_{0}, label %done_{0}
step_{0}:
  %next_{0} = add i64 %cursor_{0}, 1
  br label %scan_{0}
done_{0}:
  ret i64 %cursor_{0}
; END scan_case

; BEGIN local_storage
