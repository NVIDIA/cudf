  %next_start = call i64 @{0}(i8* %data, i64 %size, i64 %prefix_seek_start{1})
; END prefix_seek_start

; BEGIN continue
continue:
{0}
  br label %search
yes:
  %accepted_end = load i64, i64* %position, align 8
