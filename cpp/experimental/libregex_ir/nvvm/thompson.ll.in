; BEGIN find_from_prefix
define internal i1 @{0}(@workspace@i8* %data, i64 %size, i64 %search_start, i64* %match_begin, i64* %match_end, i64* %captures) nounwind {{
entry:
  %position = alloca i64, align 8
{1}search:
  %start = phi i64 [ %search_start, {2} ], [ %next_start, %continue ]
  %in_range = icmp ule i64 %start, %size
; END find_from_prefix

; BEGIN thompson_execute_prefix_search
  br label %search
search:
  %start = phi i64 [ 0, {6} ], [ %next_start, %next ]
  %at_end = icmp eq i64 %start, %size
  br i1 %at_end, label %attempt, label %filter
filter:
  %start_ptr = getelementptr i8, i8* %data, i64 %start
  %start_byte = call i32 @{0}(i8* %start_ptr)
  %candidate = {1}
{2}  br i1 {3}, label %attempt, label %skip
skip:
  %is_ascii = icmp ult i32 %start_byte, 128
  br i1 %is_ascii, label %continue_ascii, label %continue_utf8
attempt:
  store i64 %start, i64* %position, align 8
  %matched = call i1 @{4}(@workspace@i32 {5}, i8* %data, i64 %size, i64* %position, i64* null)
  br i1 %matched, label %yes, label %check_end
check_end:
  br i1 %at_end, label %no, label %continue_ascii
continue_ascii:
  %prefix_seek_start = add nuw i64 %start, 1
  %ascii_next = call i64 @{7}(i8* %data, i64 %size, i64 %prefix_seek_start{8})
  br label %next
continue_utf8:
  br label %continue_ascii
next:
  %next_start = phi i64 [ %ascii_next, %continue_ascii ]
  br label %search
yes:
  ret i1 true
no:
  ret i1 false
}}
; END thompson_execute_prefix_search

; BEGIN thompson_execute_suffix
  br label %search
search:
  %start = phi i64 [ 0, {3} ], [ %next_start, %continue ]
  store i64 %start, i64* %position, align 8
  %matched = call i1 @{0}(@workspace@i32 {1}, i8* %data, i64 %size, i64* %position, i64* null)
  br i1 %matched, label %yes, label %check_end
check_end:
  %at_end = icmp eq i64 %start, %size
  br i1 %at_end, label %no, label %continue
continue:
  %next_start = call i64 @{2}(i8* %data, i64 %size, i64 %start, i64 1)
  br label %search
yes:
  ret i1 true
no:
  ret i1 false
}}
; END thompson_execute_suffix

; BEGIN store_store_i64_0_i64_position_align_8
  store i64 0, i64* %position, align 8
