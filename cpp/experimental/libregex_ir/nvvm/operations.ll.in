entry:
  %match_begin = getelementptr i64, i64* %captures, i64 0
  %match_end = getelementptr i64, i64* %captures, i64 1
  %matched = call i1 @{1}(@workspace@i8* %data, i64 %size, i64 %search_start, i64* %match_begin, i64* %match_end, i64* %captures)
{2}
