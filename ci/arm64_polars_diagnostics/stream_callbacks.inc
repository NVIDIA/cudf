/* API, stream, object/address, auxiliary handle or byte count. */
API(cuStreamCreate, output ? *p->phStream : 0, 0, p->Flags)
API(cuStreamCreateWithPriority, output ? *p->phStream : 0, 0, p->flags)
APIS(cuStreamSynchronize, p->hStream, 0, 0)
API(cuStreamDestroy, p->hStream, 0, 0)
API(cuStreamDestroy_v2, p->hStream, 0, 0)
APIS(cuStreamWaitEvent, p->hStream, p->hEvent, p->Flags)
API(cuEventCreate, 0, output ? *p->phEvent : 0, p->Flags)
APIS(cuEventRecord, p->hStream, p->hEvent, 0)
APIS(cuEventRecordWithFlags, p->hStream, p->hEvent, p->flags)
API(cuEventSynchronize, 0, p->hEvent, 0)
API(cuEventDestroy, 0, p->hEvent, 0)
API(cuEventDestroy_v2, 0, p->hEvent, 0)
APIS(cuMemAllocAsync, p->hStream, output ? *p->dptr : 0, p->bytesize)
APIS(cuMemAllocFromPoolAsync, p->hStream, output ? *p->dptr : p->bytesize, p->pool)
APIS(cuMemFreeAsync, p->hStream, p->dptr, 0)
API(cuMemAlloc_v2, 0, output ? *p->dptr : 0, p->bytesize)
API(cuMemFree_v2, 0, p->dptr, 0)
API(cuMemPoolDestroy, 0, p->pool, 0)
API(cuCtxDestroy, 0, p->ctx, 0)
API(cuCtxDestroy_v2, 0, p->ctx, 0)
API(cuDevicePrimaryCtxRelease_v2, 0, p->dev, 0)
API(cuDevicePrimaryCtxReset_v2, 0, p->dev, 0)
NOARGS(cuCtxSynchronize)
APIS(cuLaunchKernel, p->hStream, p->f, 0)
APIS(cuLaunchKernelEx, p->config ? p->config->hStream : 0, p->f, 0)
/* Preserve both endpoints at entry and add the byte count at exit. */
APIS(cuMemcpyAsync, p->hStream, output ? p->ByteCount : p->src, p->dst)
APIS(cuMemcpyHtoDAsync_v2, p->hStream, p->dstDevice, p->ByteCount)
APIS(cuMemcpyDtoHAsync_v2, p->hStream, p->srcDevice, p->ByteCount)
APIS(cuMemcpyDtoDAsync_v2, p->hStream, output ? p->ByteCount : p->srcDevice, p->dstDevice)
