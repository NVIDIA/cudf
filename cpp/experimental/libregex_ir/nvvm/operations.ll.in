entry:
  %begin = getelementptr i64, i64* %span, i64 0
  %end = getelementptr i64, i64* %span, i64 1
  %matched = call i1 @{1}(i8* %data, i64 %size, i64 0, i64* %begin, i64* %end, i64 {2})
