work:
  %physical = add i32 %row_offset, %row
  %valid = call i1 @regex_ir_is_valid(i32* %validity, i32 %physical)
  br i1 %valid, label %replace, label %done
replace:
  %string = call %regex_ir_string @regex_ir_load_string(i8* %chars, i8* %offsets, i32 %physical)
  %data = extractvalue %regex_ir_string %string, 0
  %size = extractvalue %regex_ir_string %string, 1
  %output_offset64 = call i64 @regex_ir_load_offset_for_width(i8* %output_offsets, i32 %row, i1 @OUTPUT_OFFSET64@)
  %output_ptr = getelementptr i8, i8* %output, i64 %output_offset64
  %written = call i64 @regex_ir_replace_execute(@workspace@i8* %data, i64 %size, i8* %output_ptr)
  br label %done
done:
  ret void
}
; END limited_replace_emit

; BEGIN limited_replace_execute

define internal i64 @regex_ir_replace_execute(@workspace@i8* %data, i64 %size, i8* %output) nounwind {
entry:
  %capture_array = alloca [@CAPTURE_SLOTS@ x i64], align 8
  %captures = getelementptr [@CAPTURE_SLOTS@ x i64], [@CAPTURE_SLOTS@ x i64]* %capture_array, i32 0, i32 0
  br label %loop
loop:
  %search_start = phi i64 [ 0, %entry ], [ %match_end, %continue_nonempty ], [ %advanced_start, %continue_empty ]
  %copied = phi i64 [ 0, %entry ], [ %match_end, %continue_nonempty ], [ %match_end, %continue_empty ]
  %cursor = phi i64 [ 0, %entry ], [ %replacement_cursor, %continue_nonempty ], [ %replacement_cursor, %continue_empty ]
  %replacement_count = phi i64 [ 0, %entry ], [ %next_replacement_count, %continue_nonempty ], [ %next_replacement_count, %continue_empty ]
  %limit_reached = @LIMIT_REACHED@
  br i1 %limit_reached, label %finish_limit, label %search
search:
  %matched = call i1 @regex_ir_execute(@workspace@i8* %data, i64 %size, i64 %search_start, i64* %captures)
  br i1 %matched, label %found, label %no_match
found:
  %match_begin_ptr = getelementptr [@CAPTURE_SLOTS@ x i64], [@CAPTURE_SLOTS@ x i64]* %capture_array, i32 0, i32 0
  %match_end_ptr = getelementptr [@CAPTURE_SLOTS@ x i64], [@CAPTURE_SLOTS@ x i64]* %capture_array, i32 0, i32 1
  %match_begin = load i64, i64* %match_begin_ptr, align 8
  %match_end = load i64, i64* %match_end_ptr, align 8
  %cursor_unmatched = call i64 @regex_ir_append_range(i8* %data, i64 %copied, i64 %match_begin, i8* %output, i64 %cursor)
@REPLACEMENT_STEPS@  %next_replacement_count = add i64 %replacement_count, 1
  %nonempty = icmp ne i64 %match_begin, %match_end
  br i1 %nonempty, label %continue_nonempty, label %empty
continue_nonempty:
  br label %loop
empty:
  %empty_at_end = icmp eq i64 %match_end, %size
  br i1 %empty_at_end, label %finish_empty, label %continue_empty
continue_empty:
  %advanced_start = call i64 @regex_ir_advance_utf8(i8* %data, i64 %size, i64 %match_end)
  br label %loop
finish_limit:
  br label %finish
no_match:
  br label %finish
finish_empty:
  br label %finish
finish:
  %tail_begin = phi i64 [ %copied, %finish_limit ], [ %copied, %no_match ], [ %match_end, %finish_empty ]
  %tail_cursor = phi i64 [ %cursor, %finish_limit ], [ %cursor, %no_match ], [ %replacement_cursor, %finish_empty ]
  %final_cursor = call i64 @regex_ir_append_range(i8* %data, i64 %tail_begin, i64 %size, i8* %output, i64 %tail_cursor)
  ret i64 %final_cursor
}
; END limited_replace_execute

; BEGIN limited_replace_execute_cached
define internal i64 @regex_ir_replace_execute(@workspace@i8* %data, i64 %size, i8* %output, i64* %cache, i32 %row, i32 %capacity, i8* %overflow, i32* %count_out) nounwind {
entry:
  %capture_array = alloca [@CAPTURE_SLOTS@ x i64], align 8
  %captures = getelementptr [@CAPTURE_SLOTS@ x i64], [@CAPTURE_SLOTS@ x i64]* %capture_array, i32 0, i32 0
  br label %loop
loop:
  %search_start = phi i64 [ 0, %entry ], [ %match_end, %continue_nonempty ], [ %advanced_start, %continue_empty ]
  %copied = phi i64 [ 0, %entry ], [ %match_end, %continue_nonempty ], [ %match_end, %continue_empty ]
  %cursor = phi i64 [ 0, %entry ], [ %replacement_cursor, %continue_nonempty ], [ %replacement_cursor, %continue_empty ]
  %replacement_count = phi i64 [ 0, %entry ], [ %next_replacement_count, %continue_nonempty ], [ %next_replacement_count, %continue_empty ]
  %limit_reached = @LIMIT_REACHED@
  br i1 %limit_reached, label %finish_limit, label %search
search:
  %matched = call i1 @regex_ir_execute(@workspace@i8* %data, i64 %size, i64 %search_start, i64* %captures)
  br i1 %matched, label %found, label %no_match
found:
  %match_begin_ptr = getelementptr [@CAPTURE_SLOTS@ x i64], [@CAPTURE_SLOTS@ x i64]* %capture_array, i32 0, i32 0
  %match_end_ptr = getelementptr [@CAPTURE_SLOTS@ x i64], [@CAPTURE_SLOTS@ x i64]* %capture_array, i32 0, i32 1
  %match_begin = load i64, i64* %match_begin_ptr, align 8
  %match_end = load i64, i64* %match_end_ptr, align 8
  call void @regex_ir_cache_captures(i64* %captures, i64* %cache, i32 %row, i32 %capacity, i32 @CAPTURE_SLOTS@, i64 %replacement_count, i8* %overflow)
  %cursor_unmatched = call i64 @regex_ir_append_range(i8* %data, i64 %copied, i64 %match_begin, i8* %output, i64 %cursor)
@REPLACEMENT_STEPS@  %next_replacement_count = add i64 %replacement_count, 1
  %nonempty = icmp ne i64 %match_begin, %match_end
  br i1 %nonempty, label %continue_nonempty, label %empty
continue_nonempty:
  br label %loop
empty:
  %empty_at_end = icmp eq i64 %match_end, %size
  br i1 %empty_at_end, label %finish_empty, label %continue_empty
continue_empty:
  %advanced_start = call i64 @regex_ir_advance_utf8(i8* %data, i64 %size, i64 %match_end)
  br label %loop
finish_limit:
  br label %finish
no_match:
  br label %finish
finish_empty:
  br label %finish
finish:
  %tail_begin = phi i64 [ %copied, %finish_limit ], [ %copied, %no_match ], [ %match_end, %finish_empty ]
  %tail_cursor = phi i64 [ %cursor, %finish_limit ], [ %cursor, %no_match ], [ %replacement_cursor, %finish_empty ]
  %final_count = phi i64 [ %replacement_count, %finish_limit ], [ %replacement_count, %no_match ], [ %next_replacement_count, %finish_empty ]
  %stored_count = trunc i64 %final_count to i32
  store i32 %stored_count, i32* %count_out, align 4
  %final_cursor = call i64 @regex_ir_append_range(i8* %data, i64 %tail_begin, i64 %size, i8* %output, i64 %tail_cursor)
  ret i64 %final_cursor
}
; END limited_replace_execute_cached

; BEGIN limited_replace_size

define void @KERNEL_ENTRY@(@workspace_parameters@i8* %chars, i8* %offsets, i32* %validity, i32 %row_offset, i32 %rows, i8* %output, i32* %size_overflow) nounwind {
entry:
@workspace_entry@
  %row = @row_index@
  %in_bounds = icmp slt i32 %row, %rows
  br i1 %in_bounds, label %work, label %done
work:
  %physical = add i32 %row_offset, %row
  %valid = call i1 @regex_ir_is_valid(i32* %validity, i32 %physical)
  br i1 %valid, label %replace, label %store_zero
replace:
  %string = call %regex_ir_string @regex_ir_load_string(i8* %chars, i8* %offsets, i32 %physical)
  %data = extractvalue %regex_ir_string %string, 0
  %size = extractvalue %regex_ir_string %string, 1
  %result_size = call i64 @regex_ir_replace_execute(@workspace@i8* %data, i64 %size, i8* null)
  %too_large = icmp ugt i64 %result_size, 2147483647
  br i1 %too_large, label %mark_overflow, label %size_fits
mark_overflow:
  %overflow_old = atomicrmw max i32* %size_overflow, i32 1 monotonic
  br label %size_fits
size_fits:
  %stored_size = trunc i64 %result_size to i32
  br label %store
store_zero:
  br label %store
store:
  %value = phi i32 [ %stored_size, %size_fits ], [ 0, %store_zero ]
  %typed_output = bitcast i8* %output to i32*
  %out = getelementptr i32, i32* %typed_output, i32 %row
  store i32 %value, i32* %out, align 4
  br label %done
done:
  ret void
}
; END limited_replace_size

; BEGIN replace_emit

